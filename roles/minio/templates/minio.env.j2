# {{ ansible_managed }}
#
# Фигурные скобки это не шаблон ansible, а синтаксис самого MinIO: он
# разворачивает {1...N} в список дисков. Именно так задаётся erasure set,
# перечислять диски по одному не нужно.
MINIO_VOLUMES="{{ minio_mount_prefix }}{1...{{ minio_data_disks }}}"

MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# Слушаем весь LAN. Наружу хранилище не смотрит, TLS терминируется на traefik,
# когда до этого дойдёт дело.
MINIO_OPTS="--address :{{ minio_api_port }}"
