services:
  server:
    image: gitea/gitea:latest
    container_name: gitea
    restart: always
    
    # LXC/Proxmox security compatibility
    security_opt:
      - seccomp:unconfined
      - apparmor:unconfined

    environment:
      - USER_UID=1000
      - USER_GID=1000
      
      # Gitea Configuration
      - GITEA__server__ROOT_URL=https://{{ node_domain }}/
      - GITEA__server__DOMAIN={{ node_domain }}
      - GITEA__server__PROTOCOL=http
      - GITEA__server__HTTP_PORT={{ gitea_container_http_port }}
      - GITEA__repository__DEFAULT_BRANCH=master

    ports:
      # Expose HTTP for reverse proxy
      - "{{ gitea_container_http_port }}:{{ gitea_container_http_port }}"
      - "2222:22"

    volumes:
      # Persistent Gitea Data (Repositories, DB)
      - gitea_data:/data
      
      # Custom CA bundle (Read-Only)
      - {{ gitea_ssl_dir }}/gitea_bundle.crt:/etc/ssl/cert.pem:ro
      
      # Timezone synchronization with Host
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro

# Define external volume to prevent data loss during container recreation
volumes:
  gitea_data:
    external: true