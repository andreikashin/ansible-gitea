# {{ ansible_managed }}
#
# Файл читают все контейнеры NetBox. Права 0600: здесь пароль базы, ключ
# подписи сессий и пароль администратора.

DB_HOST={{ netbox_db_host }}
DB_PORT={{ netbox_db_port }}
DB_NAME={{ netbox_db_name }}
DB_USER={{ netbox_db_user }}
DB_PASSWORD={{ netbox_db_password }}
DB_WAIT_TIMEOUT=30

REDIS_HOST=redis-tasks
REDIS_PORT=6379
REDIS_DATABASE={{ netbox_redis_db_tasks }}
REDIS_PASSWORD={{ netbox_redis_password }}
REDIS_SSL=false

REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DATABASE={{ netbox_redis_db_cache }}
REDIS_CACHE_PASSWORD={{ netbox_redis_password }}
REDIS_CACHE_SSL=false

# Ключ подписи сессий. Смена разлогинивает всех, но данные не трогает.
SECRET_KEY={{ netbox_secret_key }}

# Соль для токенов API. С версии 4.6 NetBox хранит токены хешированными и без
# этой переменной отказывается работать с токенами второго поколения, о чём
# сообщает предупреждением в журнале, а запросы с токеном отбивает как
# "Invalid v1 token". Смена соли делает недействительными все выданные токены.
API_TOKEN_PEPPER_1={{ netbox_api_token_pepper }}

ALLOWED_HOSTS={{ netbox_allowed_hosts }}

SUPERUSER_NAME={{ netbox_superuser }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}
SKIP_SUPERUSER=false
# SUPERUSER_API_TOKEN здесь намеренно нет. С версии 4.6 токен хранится хешем с
# солью, и открытое значение задать заранее нельзя. Токен создаёт роль, и
# кладёт его в файл на госте, см. tasks/main.yml.

TIME_ZONE={{ netbox_time_zone }}
CHANGELOG_RETENTION={{ netbox_changelog_retention }}

# Почта не настроена: уведомления NetBox нам не нужны, алерты идут через
# Alertmanager. Пустой хост отключает отправку, а не роняет приложение.
EMAIL_SERVER=
EMAIL_PORT=25
EMAIL_FROM=netbox@{{ netbox_search_domain }}

# Метрики Prometheus на /metrics. Скрейп добавляется в роли observability.
METRICS_ENABLED=true

# Housekeeping и воркер запускаются отдельными контейнерами, встроенный
# планировщик образа не нужен.
HOUSEKEEPING_INTERVAL=86400
