# {{ ansible_managed }}
#
# Alertmanager стоит в цепочке с самого начала не ради доставки, а ради трёх
# вещей, которых нет у голого Prometheus: дедупликации, подавления каскадов и
# silences.
#
# Silence понадобится буквально на следующей замене диска: массив уйдёт в
# rebuild и покраснеет всё разом. Заглушить на два часа приятнее, чем смотреть.
#
{% set alert_delivery_enabled = (alert_dispatcher_port is defined) or (lab_telegram_bot_token is defined and lab_telegram_chat_id is defined) %}
{% if alert_dispatcher_port is defined %}
# Доставка алертов идёт через интеграционный хаб lab_alert-dispatcher:
# он обогащает сообщения интерактивными inline-кнопками управления (подсветка
# корзины, мигание UID шасси, создание silences в Alertmanager в один клик).
{% elif lab_telegram_bot_token is defined and lab_telegram_chat_id is defined %}
# Доставка в Telegram включена напрямую (fallback без интерактивных кнопок).
# Бот переиспользуется тот же, что у продуктового бота: заводить второго ради
# одного оператора незачем. Чат при этом личный, а не групповой канал выгрузок,
# чтобы алерты не тонули среди данных.
{% else %}
# Доставка наружу не настроена: алерты видны только в уголке лаб-дашборда,
# который читает /api/v2/alerts отсюда. Чтобы включить Telegram, задай
# lab_telegram_bot_token и lab_telegram_chat_id в host_vars.
{% endif %}

global:
  resolve_timeout: 5m

route:
  receiver: {{ 'lab-telegram' if alert_delivery_enabled else 'lab-null' }}
  group_by: ['alertname', 'node']
  group_wait: 30s
  group_interval: 5m
{% if alert_delivery_enabled %}
  # Двенадцать часов вместо суток: висящий алерт должен напоминать о себе, но не
  # долбить. Сутки стояли, пока доставки не было вовсе.
  repeat_interval: 12h
{% else %}
  # Сутки: пока алерты живут только в UI, повторять их незачем, они и так видны.
  repeat_interval: 24h
{% endif %}

  routes:
{% if alert_delivery_enabled %}
    # В мессенджер уходит ТОЛЬКО critical. Если слать всё, через месяц чат
    # замьютят, и канал доставки перестанет существовать. Warning остаётся в
    # уголке дашборда и в Grafana, там он и нужен.
    - matchers: ['severity = "critical"']
      receiver: lab-telegram
      group_wait: 10s
      repeat_interval: 4h

    - matchers: ['severity =~ "warning|info"']
      receiver: lab-null
{% else %}
    - matchers: ['severity = "critical"']
      receiver: lab-null
      group_wait: 10s
{% endif %}

receivers:
  - name: lab-null

{% if alert_dispatcher_port is defined %}
  - name: lab-telegram
    webhook_configs:
      - url: "http://{{ obs_ip }}:{{ alert_dispatcher_port }}/webhook/alertmanager{% if alertmanager_webhook_secret is defined and alertmanager_webhook_secret %}?secret={{ alertmanager_webhook_secret }}{% endif %}"
        send_resolved: true
{% elif lab_telegram_bot_token is defined and lab_telegram_chat_id is defined %}
  - name: lab-telegram
    telegram_configs:
      - bot_token: '{{ lab_telegram_bot_token }}'
        chat_id: {{ lab_telegram_chat_id }}
        parse_mode: HTML
        # Гасшее тоже сообщаем: иначе непонятно, само починилось или ещё горит.
        send_resolved: true
        # Первая строка несёт то, что читается с экрана блокировки: что сгорело
        # и на какой ноде. Подробности ниже, для того, кто откроет.
        message: |-
          {% raw %}{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b>{{ if .CommonLabels.node }} на {{ .CommonLabels.node }}{{ end }}
          {{ range .Alerts }}
          {{ .Annotations.summary }}{{ if .Annotations.description }}
          <i>{{ .Annotations.description }}</i>{{ end }}
          {{ end }}{% endraw %}
{% endif %}

# Подавление каскадов. Без этого недоступная нода выдаст восемь алертов про
# свои диски, десять про гестов и один про сборщик, а полезен из них ровно один.
inhibit_rules:
  # Молчащий сборщик делает недостоверными все метрики ноды, поэтому гасим по
  # ней всё остальное.
  - source_matchers: ['alertname = "MetricsCollectorStale"']
    target_matchers: ['severity =~ "warning|critical"']
    equal: ['node']

  # Деградировавший том важнее, чем отдельные диски в нём.
  - source_matchers: ['alertname = "RaidArrayDegraded"']
    target_matchers: ['alertname =~ "Disk.*|RaidPhysicalDiskNotOk"']
    equal: ['node']

  # Критичный алерт по той же сущности перекрывает предупреждение.
  - source_matchers: ['severity = "critical"']
    target_matchers: ['severity = "warning"']
    equal: ['alertname', 'node']
