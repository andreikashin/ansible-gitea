import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.SecretBytes
import com.cloudbees.plugins.credentials.SystemCredentialsProvider
import com.cloudbees.plugins.credentials.domains.Domain
import jenkins.model.Jenkins
import org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl

def credentialsStore = SystemCredentialsProvider.getInstance().getStore()
def globalDomain = Domain.global()
def credentialsId = {{ jenkins_k3s_kubeconfig_credentials_id | to_json }}

def existingCredential = credentialsStore.getCredentials(globalDomain).find { it.id == credentialsId }

if (existingCredential != null) {
    credentialsStore.removeCredentials(globalDomain, existingCredential)
}

// The kubeconfig itself is staged next to this script by the playbook and
// removed right after, so its bytes never live in the script.
def kubeconfigStageFile = new File({{ k3s_kubeconfig_container_dir | to_json }}, 'kubeconfig')

credentialsStore.addCredentials(globalDomain, new FileCredentialsImpl(
    CredentialsScope.GLOBAL,
    credentialsId,
    {{ jenkins_k3s_kubeconfig_credentials_description | to_json }},
    kubeconfigStageFile.name,
    SecretBytes.fromRawBytes(kubeconfigStageFile.bytes)
))

credentialsStore.save()
Jenkins.instance.save()
