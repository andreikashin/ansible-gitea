import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.SecretBytes
import com.cloudbees.plugins.credentials.SystemCredentialsProvider
import com.cloudbees.plugins.credentials.domains.Domain
import hudson.util.Secret
import jenkins.model.Jenkins
import org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl
import org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl

def credentialsStore = SystemCredentialsProvider.getInstance().getStore()
def globalDomain = Domain.global()

def upsertCredential = { String credentialId, credential ->
    def existingCredential = credentialsStore.getCredentials(globalDomain).find { it.id == credentialId }

    if (existingCredential != null) {
        credentialsStore.removeCredentials(globalDomain, existingCredential)
    }

    credentialsStore.addCredentials(globalDomain, credential)
}

def releaseKeystoreStageFile = new File({{ ip_rotation_credentials_container_dir | to_json }}, 'release.keystore')

upsertCredential({{ jenkins_ip_rotation_release_keystore_credentials_id | to_json }}, new FileCredentialsImpl(
    CredentialsScope.GLOBAL,
    {{ jenkins_ip_rotation_release_keystore_credentials_id | to_json }},
    {{ jenkins_ip_rotation_release_keystore_credentials_description | to_json }},
    releaseKeystoreStageFile.name,
    SecretBytes.fromRawBytes(releaseKeystoreStageFile.bytes)
))

upsertCredential({{ jenkins_ip_rotation_release_store_password_credentials_id | to_json }}, new StringCredentialsImpl(
    CredentialsScope.GLOBAL,
    {{ jenkins_ip_rotation_release_store_password_credentials_id | to_json }},
    {{ jenkins_ip_rotation_release_store_password_credentials_description | to_json }},
    Secret.fromString({{ ip_rotation_release_store_password | to_json }})
))

upsertCredential({{ jenkins_ip_rotation_release_key_alias_credentials_id | to_json }}, new StringCredentialsImpl(
    CredentialsScope.GLOBAL,
    {{ jenkins_ip_rotation_release_key_alias_credentials_id | to_json }},
    {{ jenkins_ip_rotation_release_key_alias_credentials_description | to_json }},
    Secret.fromString({{ ip_rotation_release_key_alias | to_json }})
))

credentialsStore.save()
Jenkins.instance.save()