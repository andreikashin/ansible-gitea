---
# Карта сети: единственный источник правды по сегментам. Отсюда её берут обе
# роли: net_switch раскладывает VLAN по портам 2960X, net_router поднимает
# шлюзы, DHCP и правила на MikroTik.
#
# Это шаблон. Скопируй в network_group.yml (тот в .gitignore) и подставь свои
# адреса. Здесь стоят заглушки из 198.18.0.0/15, диапазона для тестов из
# RFC 2544: он гарантированно не совпадёт ни с чьей реальной сетью.
#
# Соответствует разделу "Сеть" в LAB_PLAN. Правишь план - правь и это.

# VLAN 2 сознательно без шлюза: нет маршрута - нет способа обойти правило
# файрвола. Это про iLO, где живут питание, виртуальные носители и консоль до
# загрузки ОС.
net_segments:
  - vlan: 2
    name: IPMI
    subnet: 198.18.2.0/24
    router: false
    dhcp: false

  - vlan: 10
    name: MGMT
    subnet: 198.18.10.0/24
    gateway: 198.18.10.1
    router: true
    dhcp: false

  - vlan: 20
    name: SERVERS
    subnet: 198.18.20.0/24
    gateway: 198.18.20.1
    router: true
    dhcp: false

  - vlan: 30
    name: CONSOLE
    subnet: 198.18.30.0/24
    gateway: 198.18.30.1
    router: true
    dhcp: true
    dhcp_pool: 198.18.30.100-198.18.30.150

  - vlan: 50
    name: DMZ
    subnet: 198.18.50.0/24
    gateway: 198.18.50.1
    router: true
    dhcp: false

  - vlan: 99
    name: CLIENTS
    subnet: 198.18.99.0/24
    gateway: 198.18.99.1
    router: true
    dhcp: true
    dhcp_pool: 198.18.99.100-198.18.99.200

# Native VLAN на транках. Пока хосты ничего не тегируют, они продолжают
# работать в старой плоской сети: это и есть этап 1 переезда.
net_native_vlan: 20

# DNS всей лабы живёт на OPNsense, а не на роутере. Адрес раздаётся по DHCP и
# отдельно разрешается из всех сегментов правилом в forward.
net_dns_server: 198.18.20.253

# Куда складывать снимки конфигов перед изменением. Вне репозитория.
net_backup_dir: "{{ lookup('env', 'HOME') }}/net-backups"
