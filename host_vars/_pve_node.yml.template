ansible_host: 192.168.1.10
ansible_user: root

# Optional: use a stable folder name for this Proxmox node or cluster.
# proxmox_backup_folder_name: pve-cluster-1

# Sensitive/local destination path for fetched backups and config files.
# Keep this in host_vars so it does not end up in the public repository.
proxmox_backup_local_dir: 'C:\Users\blabla\Proxmox'

# HP Smart Array: without ssacli the raid-smartarray probe silently returns zero.
# lab_metrics_install_ssacli: true

# Memory channels per CPU socket, used by the 70-memory probe.
#
# This cannot be detected: SMBIOS knows nothing about channels, and EDAC reports
# the topology inconsistently and sometimes wrongly (it claims six channels on a
# four-channel Broadwell, and exposes no channels at all on Skylake-SP). So the
# fact lives here, next to the other per-node facts. Leave it out and the probe
# simply omits the metric: a guess would be worse than silence.
#
# Typical values: Westmere 3, Broadwell 4, Skylake-SP 6.
lab_metrics_extra_env:
  MEM_CHANNELS_PER_SOCKET: 4

  # Guests that run scheduled database dumps inside themselves, used by the
  # 80-guest-dumps probe. node_exporter runs on the hypervisors only and guests
  # are not scraped, so the age of the newest dump is read from the outside
  # through the guest agent (qm) or the container exec (pct).
  #
  # Format is "<vmid>:<qm|pct>", space separated. Guests are listed explicitly
  # on purpose: the node cannot know which of them keep dumps, and polling every
  # guest hourly would hammer the agent on all the ones that do not.
  #
  # The convention inside a guest is /var/backups/<set>/, one series per
  # subdirectory. Sets with different schedules must live in different
  # directories, otherwise the frequent one keeps the directory fresh and hides
  # a stalled rare one.
  # DUMP_GUESTS: "101:qm 102:pct"

